# Docker Compose only. Local non-Docker backend uses server/.env instead.
COMPOSE_PROJECT_NAME=stick-it
WEB_IMAGE=stick-it-web:2.3.0
API_IMAGE=stick-it-api:2.3.0
# Always published on VPS loopback; do not change compose.yaml to 0.0.0.0.
HTTP_PORT=8080
# Optional: exact Docker frontend gateway address when a trusted host reverse
# proxy overwrites X-Real-IP. Leave empty for direct loopback access.
TRUSTED_HOST_PROXY=
LOG_LEVEL=info
APP_ORIGIN=http://127.0.0.1:8080
# Test stand is loopback-only over SSH. Use true when enabling HTTPS.
COOKIE_SECURE=false
SESSION_HOURS=12
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
BOOTSTRAP_ADMIN_1_LOGIN=
BOOTSTRAP_ADMIN_1_NAME=
BOOTSTRAP_ADMIN_1_PASSWORD=
BOOTSTRAP_ADMIN_2_LOGIN=
BOOTSTRAP_ADMIN_2_NAME=
BOOTSTRAP_ADMIN_2_PASSWORD=

POSTGRES_DB=stickit
POSTGRES_APP_USER=stickit
# Supply different real secrets. Generate each with: openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
# Use the app role/password, host postgres, port 5432, and POSTGRES_DB.
# postgresql://<app-user>:<URL-encoded-app-password>@postgres:5432/<database>
DATABASE_URL=

DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
POSTGRES_VOLUME_NAME=stickit_postgres
UPLOADS_VOLUME_NAME=stickit_uploads
# The application path inside the api container is fixed: /app/uploads.
