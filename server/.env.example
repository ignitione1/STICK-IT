NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
APP_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY=none
# false only for loopback HTTP development / SSH tunnel; use true with HTTPS.
COOKIE_SECURE=false
SESSION_HOURS=12
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
BOOTSTRAP_ADMIN_1_LOGIN=
BOOTSTRAP_ADMIN_1_NAME=
BOOTSTRAP_ADMIN_1_PASSWORD=
BOOTSTRAP_ADMIN_2_LOGIN=
BOOTSTRAP_ADMIN_2_NAME=
BOOTSTRAP_ADMIN_2_PASSWORD=
# Persistent attachment storage; back up together with the database.
UPLOAD_DIR=uploads
# Leave empty to run HTTP infrastructure without a database.
# Set your own URL: postgresql://<role>:<encoded-password>@127.0.0.1:5432/<database>
DATABASE_URL=
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
