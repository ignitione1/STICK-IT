{
  "name": "stickerboard-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:local": "tsx scripts/local.ts",
    "push:keys": "tsx scripts/generate-push-keys.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "node dist/db/migrate.js",
    "db:check": "tsx src/db/check.ts",
    "admin:create": "tsx src/create-admin.ts",
    "admin:bootstrap": "tsx src/bootstrap-admins.ts",
    "test:browser-server": "tsx tests/browser-server.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@node-rs/argon2": "^2.2.2",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
